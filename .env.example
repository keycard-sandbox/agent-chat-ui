# LangGraph Configuration
NEXT_PUBLIC_API_URL=http://localhost:2024
NEXT_PUBLIC_ASSISTANT_ID=agent
# Optional. Required for Agent Builder deployments.
# Set to "langsmith-api-key" when using a LangSmith PAT.
NEXT_PUBLIC_AUTH_SCHEME=
# Do NOT prefix this with "NEXT_PUBLIC_" as we do not want this exposed in the client.
LANGSMITH_API_KEY=

# Production LangGraph Configuration (quickstart) - Uncomment to use
# NEXT_PUBLIC_ASSISTANT_ID="agent"
# This should be the deployment URL of your LangGraph server
# LANGGRAPH_API_URL="https://my-agent.default.us.langgraph.app"
# This should be the URL of your website + "/api". This is how you connect to the API proxy
# NEXT_PUBLIC_API_URL="https://my-website.com/api"
# LANGSMITH_API_KEY="lsv2_..."

# Keycard sign-in (optional) - Uncomment to use
# With these unset, this fork behaves exactly like stock upstream.
# Every value is server side: nothing here is prefixed with NEXT_PUBLIC_,
# because the bearer stays in an httpOnly cookie the API proxy reads.
# The chat must go through the proxy for that to work, so point
# NEXT_PUBLIC_API_URL at your own site + "/api".
# KEYCARD_ZONE_URL="https://my-zone.keycard.cloud"
# KEYCARD_CLIENT_ID="my-chat-ui"
# Only for confidential clients. Public clients leave it unset.
# KEYCARD_CLIENT_SECRET=
# The LangGraph server's own URL, which the issued token is audienced at.
# Defaults to LANGGRAPH_API_URL.
# KEYCARD_AGENT_RESOURCE="https://my-agent.fly.dev"
# Overrides the request origin when building the redirect URI, for
# deployments behind a proxy that rewrites it.
# KEYCARD_APP_URL="https://my-website.com"
